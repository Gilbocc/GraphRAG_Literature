# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- OpenRouter (one key covers chat completions AND embeddings) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_LLM_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match the embedding model's output size. text-embedding-3-small -> 1536.
EMBEDDING_DIMENSIONS=1536

# --- Chunking ---
CHUNK_SIZE=4000
CHUNK_OVERLAP=400

# --- Community detection ---
COMMUNITY_ALGORITHM=leiden   # leiden | louvain
MIN_COMMUNITY_SIZE=4

# --- GROBID (scholarly PDF structuring; required, no fallback parser) ---
GROBID_URL=http://localhost:8070

# --- OpenAlex (bibliographic enrichment; no key needed, mailto = polite pool) ---
OPENALEX_MAILTO=you@example.com

# --- LLM call behaviour ---
LLM_MAX_TOKENS=32000
LLM_REASONING_EFFORT=low     # low|medium|high, or blank for the model default
EXTRACT_CONCURRENCY=8
OPENROUTER_PROVIDER_ORDER=groq   # comma-separated; blank = let OpenRouter choose
OPENROUTER_ALLOW_FALLBACKS=true
COMMUNITY_RESOLUTION=0.6

# --- Querying (answer generation) ---
# Each of these falls back to the extraction setting above when unset, so
# leaving the whole block commented out changes nothing. Extraction is one
# cheap call per chunk; answering is a handful of calls that synthesise across
# papers, which is where a stronger model earns its cost.
# QUERY_LLM_MODEL=anthropic/claude-sonnet-4.5
# If QUERY_LLM_MODEL is not a groq-served model, the pinned provider above
# cannot serve it. Blank this to let OpenRouter route it.
# QUERY_PROVIDER_ORDER=
# QUERY_REASONING_EFFORT=high
# Deterministic by default: a citation that changes between runs is not checkable.
# QUERY_TEMPERATURE=0.0
